# Vector store
# Same Qdrant endpoint used by the sibling rag-bench project.
QDRANT_URL=http://192.168.1.50:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=elite_rag
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse
# Initial request plus four retries: 0.5s, 1s, 2s, and 4s backoff.
QDRANT_UPSERT_MAX_ATTEMPTS=5
QDRANT_UPSERT_INITIAL_BACKOFF_SECONDS=0.5
QDRANT_UPSERT_MAX_BACKOFF_SECONDS=4.0
# PostgreSQL durable-ingestion ledger. Use a dedicated database user in production.
INGESTION_DATABASE_URL=postgresql://USER:PASSWORD@192.168.1.50:5432/elite_rag
INGESTION_LEASE_SECONDS=900
INGESTION_PIPELINE_VERSION=v1
SPARSE_EMBEDDING_MODEL=Qdrant/minicoil-v1
SPARSE_EMBEDDING_URL=http://192.168.1.50:8000/v1/embeddings/sparse
SPARSE_EMBEDDING_BATCH_SIZE=8
SPARSE_EMBEDDING_TIMEOUT_SECONDS=120
SPARSE_EMBEDDING_MAX_ATTEMPTS=5
SPARSE_EMBEDDING_INITIAL_BACKOFF_SECONDS=0.5
SPARSE_EMBEDDING_MAX_BACKOFF_SECONDS=4
HYBRID_CANDIDATE_LIMIT=100

# Local OpenAI-compatible embedding service (rag-bench configuration)
OPENAI_LOCAL_ENDPOINT=http://192.168.1.50:1234/v1
EMBEDDING_MODEL=text-embedding-embeddinggemma-300m
EMBEDDING_DIMENSION=768
EMBEDDING_API_KEY=lm-studio
CHILD_MAX_TOKENS=150
PARENT_MAX_TOKENS=2000
INGEST_BATCH_SIZE=64
LOG_FILE=logs/elite-rag.log
LOG_LEVEL=INFO
MISSING_DOCS_FILE=logs/missing_docs.json

# RustFS S3-compatible object storage (rag-bench configuration names)
S3_ENDPOINT_URL=http://192.168.1.50:9000
S3_ACCESS_KEY=access
S3_SECRET_KEY=secret
S3_BUCKET=enterprise-rag
S3_PATH_MARKDOWN_PREFIX=documents

# Local FastAPI Jina reranker (rag-bench configuration)
JINA_RERANK_URL=http://192.168.1.50:8000/v1/rerank
JINA_RERANK_MODEL=jina-reranker-v3.5
RERANK_TOP_N=10
RERANK_CONFIDENCE_THRESHOLD=0.35
PRIMARY_VECTOR_LIMIT=25
FALLBACK_VECTOR_LIMIT=50

# Local Qwen generation and Llama evaluation models (rag-bench configuration)
RAG_MODEL=qwen2.5-7b-instruct-mlx
EVAL_MODEL=meta-llama-3.1-8b-instruct
LLM_API_KEY=lm-studio
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.0
LLM_TOP_P=0.1
